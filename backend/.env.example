# Supabase: dashboard > Connect > Connection string > URI > Transaction (ou Session) pooler
# Formato pooler: postgresql://postgres.<project-ref>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Formato direct: postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.mjpicvyfndroyqjokdgx.supabase.co:5432/postgres
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Instagram API com Instagram Login (https://developers.facebook.com/docs/instagram-platform)
# App ID + secret vêm do app criado em developers.facebook.com.
# Use case necessário no app: "Manage messages and content on Instagram" com as permissões
#   `instagram_business_basic` e `instagram_business_manage_insights` solicitadas.
# REDIRECT_URI deve estar registrada em "Instagram > Login Settings > Valid OAuth Redirect URIs"
# e bater EXATAMENTE com o que o frontend manda (sem barra final, sem query string).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/admin/conectar-instagram

CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development
